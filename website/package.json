{
  "name": "floatlet-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/sync-theme-csp.mjs --check && node scripts/gate.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
