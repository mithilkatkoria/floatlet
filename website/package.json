    "check": "astro check",
    "theme:csp": "node scripts/sync-theme-csp.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@supabase/supabase-js": "2.118.0",
    "astro": "7.3.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.13.4"
  }
}
