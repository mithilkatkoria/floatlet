---
const modes=[['idle','Compact'],['music','Music'],['files','Tray'],['controls','Controls'],['clock','Clock'],['calendar','Calendar'],['call','Calls'],['settings','Settings']];
const spotify='<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1ed760"/><g fill="none" stroke="#07130b" stroke-width="1.7" stroke-linecap="round"><path d="M5 9q7-3 14 1M6 12q6-2 12 1M7 15q5-1.5 10 1"/></g></svg>';
---
<div class="demo" id="island-demo" data-mode="idle" data-playing="true" data-clarity-mask="true">
<div class="demo-toolbar"><span><span class="small-pill"></span> FLOATLET PLAYGROUND · RELEASE + DEVELOPMENT</span><button class="text-button" id="reset-demo">Reset preview</button></div>
<div class="desktop-stage"><div class="stage-top"><span>SMALL SPACE. MORE POSSIBILITIES.</span><span>INTERACTIVE · SAMPLE DATA</span></div><div class="capsule-anchor"><div class="capsule" id="capsule" tabindex="0" role="group" aria-label="Floatlet preview. Press Enter to expand.">
<div class="compact-content"><div class="cover-mini cover-art"><span class="spotify-badge" set:html={spotify}/></div><div class="compact-copy"><strong id="compact-title">A slower morning</strong><small id="compact-subtitle">Floatlet Sessions</small></div><div class="mini-wave" aria-label="Sample waveform">{Array.from({length:9},(_,i)=><i style={`--i:${i}`}/>)}</div><span id="compact-clock" hidden></span></div>
<div class="peek-transport"><button data-transport="previous" aria-label="Previous sample track">Ⅰ◀</button><button data-transport="play" aria-label="Pause sample track">Ⅱ</button><button data-transport="next" aria-label="Next sample track">▶Ⅰ</button></div>
<div class="notice-card" hidden><span class="notice-symbol" aria-hidden="true">◷</span><div><strong id="notice-title">Timer complete</strong><small id="notice-subtitle">Open Clock to dismiss</small></div></div>
<button id="minimize-demo" aria-label="Minimize preview to screen edge" title="Minimize to screen edge">−</button><button id="restore-demo" aria-label="Restore island preview">‹</button><div class="capsule-inner" inert><div class="island-tabs" aria-label="Island panels"><button data-mode="music">Music</button><button data-mode="files">Tray</button><button data-mode="controls">Controls</button><button data-mode="clock">Clock</button><button data-mode="settings" aria-label="Preview settings">⚙</button><button id="pin-demo" aria-label="Pin preview" aria-pressed="false">⌖</button></div>
<div id="demo-music" class="island-panel"><div class="music-layout"><div><div class="track"><div class="album cover-art"><span class="spotify-badge" set:html={spotify}/></div><div><strong id="track-name">A slower morning</strong><span>Floatlet Sessions</span><small class="spotify-label">Spotify · sample</small></div></div><div class="transport"><button data-transport="previous" aria-label="Previous sample track">Ⅰ◀</button><button data-transport="play" class="play" aria-label="Pause sample track">Ⅱ</button><button data-transport="next" aria-label="Next sample track">▶Ⅰ</button></div></div><button class="date-tile" data-mode="calendar" aria-label="Open sample calendar"><small id="music-month">SEP</small><strong id="music-day">14</strong><span>Calendar ↗</span></button></div><div class="provider-picker" aria-label="Sample music provider"><button data-provider="Spotify" aria-pressed="true">Spotify</button><button data-provider="Apple Music" aria-pressed="false">Apple Music</button><button data-provider="YouTube" aria-pressed="false">YouTube</button></div><div class="song-progress"><i></i></div></div>
<div id="demo-files" class="island-panel" hidden><div class="tray-heading"><strong>Keep it here. Take it anywhere.</strong><span>Sample references. Originals stay put.</span></div><ul id="sample-files"></ul><button class="tray-add" id="add-file">+ Add sample file</button><button class="tray-add" id="sample-screenshot">▣ Screenshot</button></div>
<div id="demo-controls" class="island-panel" hidden><div class="system-grid"><div><small>CPU · sample</small><strong>0.5%</strong></div><div><small>Memory · sample</small><strong>45 MB</strong></div><div><small>Battery · sample</small><strong>90%</strong></div></div><div class="connectivity"><button data-native="Wi-Fi">◉ Wi-Fi <small>Nearby networks</small></button><button data-native="Bluetooth">ᛒ Bluetooth <small>Windows devices</small></button></div><div class="slider-card"><label for="brightness">☀ Display <output id="brightness-value">70%</output></label><input id="brightness" type="range" min="0" max="100" value="70"/></div><div class="slider-card"><label for="volume">Sound <output id="volume-value">42%</output></label><div class="slider-row"><button id="mute" aria-label="Mute sample sound" aria-pressed="false">♪</button><input id="volume" type="range" min="0" max="100" value="42"/></div></div><div class="quick-settings"><button data-native="Night light">Night light</button><button data-native="Screen mirroring">Mirror</button><button data-native="Energy saver">Energy saver</button></div></div>
<div id="demo-clock" class="island-panel" hidden><div class="clock-tabs"><button data-clock="timer" aria-pressed="true">Timer</button><button data-clock="stopwatch">Stopwatch</button><button data-clock="alarm">Alarm</button></div><div class="clock-face"><span class="clock-ring"></span><strong id="clock-readout">00:10</strong><small id="clock-caption">A ten-second preview</small></div><div class="clock-actions"><button id="clock-reset">Reset</button><button id="clock-start">Start timer</button></div><button id="dismiss-alert" hidden>Dismiss alert</button><p class="sample-note">Sample clocks run while this page is open. No sound.</p></div>
<div id="demo-calendar" class="island-panel" hidden><div class="calendar-heading"><button id="calendar-prev" aria-label="Previous month">‹</button><strong id="calendar-month"></strong><button id="calendar-next" aria-label="Next month">›</button></div><div class="calendar-week">{'MTWTFSS'.split('').map(d=><span>{d}</span>)}</div><div id="calendar-grid"></div><div id="day-agenda"></div><div class="calendar-footer"><span>● Personal <span class="work-dot">●</span> Work · sample</span><button id="calendar-reminder">Preview reminder</button></div></div>
<div id="demo-call" class="island-panel" hidden><div class="call-avatar" aria-hidden="true">♬</div><strong class="call-name">Discord</strong><p class="sample-note">Microphone activity · sample</p><div class="call-actions"><button id="call-mute" aria-pressed="false">Mute microphone</button><button id="call-open">Open call app ↗</button></div><p class="sample-note">Mute is device-wide in the app. Participant names, deafen and hang-up stay in Discord.</p></div>
<div id="demo-settings" class="island-panel" hidden><h3 class="settings-title">Make it yours.</h3><label class="preference">Icon-only music bar <input id="icon-only" type="checkbox" role="switch"/></label><label class="preference">Reduce motion <input id="reduce-motion" type="checkbox" role="switch"/></label><label class="preference">Show calls <input id="show-calls" type="checkbox" role="switch" checked/></label><button class="settings-demo" data-mode="calendar">Google Calendars <span>Up to 8 links ↗</span></button><p class="sample-note">In the app, add each calendar's Secret iCal address. Preview settings stay on this page.</p><p class="creator-credit">made by draey.dev</p></div>
</div></div></div><div class="desktop-caption"><span id="stage-hint">Your music, without the extra window.</span><button id="sample-card" draggable="true" class="sample-card" hidden>▤ Weekend notes.txt <small>DRAG INTO THE TRAY</small></button><span class="stage-count" id="stage-count">01 / 08</span></div></div>
<div class="demo-bottom"><div class="mode-selector" aria-label="Preview mode">{modes.map(([mode,label])=><button data-mode={mode} aria-pressed={mode==='idle'?'true':'false'}>{label}</button>)}</div><p id="demo-status" role="status">Hover the music bar, or explore a panel. No accounts connected.</p></div><div class="demo-scenarios"><span>TRY A MOMENT</span><button id="search-preview" data-search-open>⌕ Search preview</button><button data-notice="image">▣ Image copied</button><button data-notice="timer">◷ Timer finished</button><button data-notice="alarm">◴ Alarm ringing</button><button data-notice="calendar">▦ Calendar reminder</button></div></div>
<dialog id="search-dialog" aria-labelledby="search-demo-title"><div class="search-demo-top"><span id="search-demo-title">FLOATLET SEARCH <small>DEVELOPMENT PREVIEW</small></span><form method="dialog"><button aria-label="Close search preview" class="keycap">esc</button></form></div><label class="search-input-wrap"><span aria-hidden="true">⌕</span><input id="search-sample-input" aria-label="Search sample apps, files and commands" placeholder="Search your PC" autocomplete="off" spellcheck="false"/></label><p class="search-result-label">SAMPLE RESULTS</p><ul id="search-sample-results" aria-label="Search sample results"></ul><div class="search-demo-footer"><span>↑ ↓ Select · Enter Preview</span><span>No access to your files</span></div><p id="search-sample-status" role="status">Try Google, Notepad or Calendar. Apps appear before folders.</p><a href="/docs/search/">About Search and release availability ↗</a></dialog>
<script>import '../scripts/demo';</script>
