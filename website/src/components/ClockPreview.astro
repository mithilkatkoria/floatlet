<div class="clock-tabs"><button data-clock="alarm" aria-pressed="false">Alarm</button><button data-clock="timer" aria-pressed="true">Timer</button><button data-clock="stopwatch" aria-pressed="false">Stopwatch</button></div>
<div class="clock-face"><div class="timer-scale" aria-hidden="true"><div class="scale-labels">{[0,5,10,15,20,25,30].map(n=><span>{n}</span>)}</div><div class="scale-ticks">{Array.from({length:61},(_,i)=><i class={i%10===0?'major':''}/>)}</div><span class="scale-pointer"></span></div><input id="timer-duration" type="range" min="1" max="30" step="1" value="5" aria-label="Timer duration in minutes"/><div class="stopwatch-dial" aria-hidden="true"><div class="dial-ticks">{Array.from({length:60},(_,i)=><i class={i%5===0?'major':''} style={`--tick:${i}`}/>)}</div><span class="dial-label top">60</span><span class="dial-label right">15</span><span class="dial-label bottom">30</span><span class="dial-label left">45</span><span class="dial-hand"></span><span class="dial-pin"></span></div><div class="timer-progress" aria-hidden="true"></div><strong id="clock-readout">05:00</strong><small id="clock-caption">Drag scale or use a preset</small></div>
<div class="alarm-editor"><label>Hour <input id="alarm-hour" type="number" min="0" max="23" value="9" inputmode="numeric"/></label><span>:</span><label>Minute <input id="alarm-minute" type="number" min="0" max="59" value="0" inputmode="numeric"/></label></div>
<div class="clock-actions"><button id="clock-reset">Reset</button><button id="clock-lap" hidden>Lap</button><button id="clock-start">Start timer</button></div>
<div class="timer-options"><button id="exact-time">Custom</button><div class="timer-presets">{[1,5,10,25].map(n=><button data-minutes={n}>{n} min</button>)}</div><div class="timer-adjust"><button id="timer-less" aria-label="Remove one minute">−</button><button id="timer-more" aria-label="Add one minute">+</button></div></div>
<form id="exact-timer-form" hidden><div class="exact-heading"><strong>Your time. Your pace.</strong></div><p class="exact-subtitle">Choose a duration</p><div class="exact-fields">{['hours','minutes','seconds'].map((unit,i)=><label><span>{unit}</span><button type="button" data-time-step={unit} data-step="1" aria-label={`Increase ${unit}`}>+</button><input id={`timer-${unit}`} aria-label={unit} type="number" min="0" max={i===0?'24':'59'} value={i===1?'5':'0'} inputmode="numeric" required/><button type="button" data-time-step={unit} data-step="-1" aria-label={`Decrease ${unit}`}>-</button></label>)}</div><p id="timer-error" role="status">Type a value, or use + and -</p><div class="exact-actions"><button type="button" id="cancel-exact">Cancel</button><button type="submit">Start timer</button></div></form>
<p id="clock-lap-summary" class="sample-note" hidden></p><button id="dismiss-alert" hidden>Dismiss alert</button><p class="clock-browser-note">Runs while this page is open. Preview is silent.</p>