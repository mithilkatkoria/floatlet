<div class="clock-tabs"><button data-clock="alarm" aria-pressed="false">Alarm</button><button data-clock="timer" aria-pressed="true">Timer</button><button data-clock="stopwatch" aria-pressed="false">Stopwatch</button></div>
<div class="clock-face"><div class="timer-scale" aria-hidden="true"><div class="scale-labels">{[0,5,10,15,20,25,30].map(n=><span>{n}</span>)}</div><div class="scale-ticks">{Array.from({length:61},(_,i)=><i class={i%10===0?'major':''}/>)}</div><span class="scale-pointer"></span></div><input id="timer-duration" type="range" min="1" max="30" step="1" value="5" aria-label="Timer duration in minutes"/><div class="stopwatch-dial" aria-hidden="true"><div class="dial-ticks">{Array.from({length:60},(_,i)=><i class={i%5===0?'major':''} style={`--tick:${i}`}/>)}</div><span class="dial-label top">60</span><span class="dial-label right">15</span><span class="dial-label bottom">30</span><span class="dial-label left">45</span><span class="dial-hand"></span><span class="dial-pin"></span></div><strong id="clock-readout">05:00</strong><small id="clock-caption">Drag scale or use a preset</small></div>
<div class="alarm-editor"><label>Hour <input id="alarm-hour" type="number" min="0" max="23" value="9" inputmode="numeric"/></label><span>:</span><label>Minute <input id="alarm-minute" type="number" min="0" max="59" value="0" inputmode="numeric"/></label></div>
<div class="clock-actions"><button id="clock-reset">Reset</button><button id="clock-lap" hidden>Lap</button><button id="clock-start">Start timer</button></div>
<div class="timer-options"><button id="exact-time">Set exact time</button><div class="timer-presets">{[1,5,10,25].map(n=><button data-minutes={n}>{n} min</button>)}</div><div class="timer-adjust"><button id="timer-less" aria-label="Remove one minute">−</button><button id="timer-more" aria-label="Add one minute">+</button></div></div>
<form id="exact-timer-form" hidden><div class="exact-heading"><strong>Set exact time</strong><button type="button" id="cancel-exact" aria-label="Cancel custom timer">×</button></div><div class="exact-fields"><label>Hours<input id="timer-hours" type="number" min="0" max="23" value="0" inputmode="numeric" required/></label><label>Minutes<input id="timer-minutes" type="number" min="0" max="59" value="5" inputmode="numeric" required/></label><label>Seconds<input id="timer-seconds" type="number" min="0" max="59" value="0" inputmode="numeric" required/></label></div><p id="timer-error" role="status"></p><button type="submit">Use this time</button></form>
<p id="clock-lap-summary" class="sample-note" hidden></p><button id="dismiss-alert" hidden>Dismiss alert</button><p class="clock-browser-note">Runs while this page is open. Preview is silent.</p>