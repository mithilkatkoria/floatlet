<div class="lamp-control">
  <button class="theme-lamp" id="theme-lamp" type="button" role="switch" aria-label="Dark theme" aria-checked="false" aria-describedby="lamp-instructions">
    <svg viewBox="0 0 140 206" width="140" height="206" fill="none" aria-hidden="true">
      <defs><linearGradient id="floatlet-lamp-shade" x1="34" y1="31" x2="91" y2="93" gradientUnits="userSpaceOnUse"><stop stop-color="#777a77"/><stop offset=".5" stop-color="#454a46"/><stop offset="1" stop-color="#242b27"/></linearGradient></defs>
      <g class="lamp-head">
        <path class="lamp-stem" d="M59 0v36"/>
        <ellipse class="lamp-halo" cx="59" cy="95" rx="43" ry="13"/>
        <path class="lamp-bulb" d="M44 90a15 15 0 0 0 30 0Z"/>
        <path class="lamp-shade" d="M39 36h40l38 51q2 3-2 3H3q-4 0-2-3Z"/>
        <path class="lamp-rim" d="M5 90h108"/>
      </g>
      <path class="lamp-cord-shadow" d="M103 90Q103 128 103 165"/>
      <path class="lamp-cord" d="M103 90Q103 128 103 165"/>
      <g class="lamp-handle" transform="translate(103 165)"><rect x="-7" y="-3" width="14" height="21" rx="7"/><path d="M-2 2v10m4-10v10"/></g>
    </svg>
