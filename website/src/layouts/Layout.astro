---
import {product} from '../data/site';
import {release} from '../data/release';
import '../styles/core.css';
import ThemeLamp from '../components/ThemeLamp.astro';
import Icon from '../components/Icon.astro';
import {themeBootstrap} from '../lib/theme-bootstrap';
const {title=product.name,description=product.description}=Astro.props;
const canonical=product.origin?new URL(Astro.url.pathname,product.origin).href:null;
const indexable=product.mode==='production'&&!['/privacy/','/terms/','/account/','/404.html','/404/'].includes(Astro.url.pathname);
const routeNames:Record<string,string>={'download':'Download','dynamic-island-for-windows':'Dynamic Island for Windows','docs/install':'Installation guide','docs/uninstall':'Uninstall guide','docs/capabilities':'Features and compatibility','docs/search':'Search guide','changelog':'Changelog','support':'Support','licenses':'Licenses','privacy':'Privacy','terms':'Terms'};
const route=Astro.url.pathname.replace(/^\/|\/$/g,'');
const breadcrumb=routeNames[route];
const socialImage=new URL('/social-card.png',product.origin).href;
const structured={'@context':'https://schema.org','@graph':[
{'@type':'WebPage','@id':canonical+'#page',url:canonical,name:title,description,inLanguage:'en',isPartOf:{'@id':product.origin+'/#website'},about:{'@id':product.origin+'/#app'}},
{'@type':'WebSite','@id':product.origin+'/#website',url:product.origin+'/',name:'Floatlet',description:product.description},
{'@type':'SoftwareApplication','@id':product.origin+'/#app',name:'Floatlet',url:product.origin+'/',description:product.description,image:socialImage,applicationCategory:'UtilitiesApplication',operatingSystem:'Windows 10, Windows 11',softwareVersion:release?.version,downloadUrl:release?.url,license:product.repository+'/blob/main/LICENSE',softwareHelp:product.origin+'/docs/install/',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},author:{'@type':'Organization',name:product.author}},...(breadcrumb?[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Floatlet',item:product.origin+'/'},{'@type':'ListItem',position:2,name:breadcrumb,item:canonical}]}]:[])]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow,max-image-preview:large':'noindex,follow'}/><title>{title}</title>{canonical&&<link rel="canonical" href={canonical}/>}
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:site_name" content="Floatlet"/><meta property="og:locale" content="en_GB"/><meta property="og:image" content={socialImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Floatlet. A little island, a calmer Windows desktop."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content="Floatlet, a free Dynamic Island for Windows 10 and 11."/><meta name="theme-color" content="#f7f6f1"/><script is:inline set:html={themeBootstrap}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script is:inline type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} /></head>
<body><a class="skip" href="#main">Skip to content</a><header class="site-header wrap"><a class="wordmark" href="/"><img class="brand-mark" src="/favicon.svg" width="34" height="34" alt=""/>Floatlet<span class="beta">PREVIEW</span></a><nav aria-label="Main navigation"><a href="/#experience">Explore</a><a href="/docs/install/">Guide</a><a class="nav-download" href="/download/">Get Floatlet <Icon name="download" size={16}/></a></nav><ThemeLamp/></header>
<main id="main">{breadcrumb&&<nav class="breadcrumbs wrap" aria-label="Breadcrumb"><ol><li><a href="/">Floatlet</a></li><li aria-current="page">{breadcrumb}</li></ol></nav>}<slot/></main>
<footer class="wrap"><div class="footer-top"><a class="wordmark" href="/"><img class="brand-mark" src="/favicon.svg" width="34" height="34" alt=""/>Floatlet</a><p>A little more room for what matters.</p><a href={product.repository} data-event="github_click" data-placement="footer">Find us on GitHub ↗</a></div><div class="footer-links"><span>© {new Date().getFullYear()} {product.author}</span><a href="/dynamic-island-for-windows/">Windows guide</a><a href="/docs/search/">Search preview</a><a href="/changelog/">Changelog</a><a href="/support/">Support</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/licenses/">Licenses</a><button class="text-button" id="privacy-open">Privacy settings</button></div><p class="fine">Independent software for Windows. Not affiliated with Apple or Microsoft.</p></footer>
<section id="privacy-banner" class="privacy-banner" aria-label="Optional website analytics" hidden><div><strong>Help improve Floatlet?</strong><p>Allow Google Analytics to measure visits and download clicks. No ads or session recordings.</p></div><div class="privacy-banner-actions"><button id="privacy-banner-accept" class="button secondary" type="button">Allow analytics</button><button id="privacy-banner-reject" class="button secondary" type="button">No thanks</button><button id="privacy-settings" class="text-button" type="button">Settings</button></div></section>
<dialog id="privacy-dialog" aria-labelledby="privacy-title"><form method="dialog"><button class="dialog-close" aria-label="Close privacy settings">×</button><p class="eyebrow">YOUR CHOICE</p><h2 id="privacy-title">Privacy settings</h2><p id="privacy-status">Allow Google Analytics to measure visits and download clicks. Downloads work either way.</p><label class="choice"><span>Usage analytics<small>Page visits, demo interactions and download clicks.</small></span><input id="analytics-choice" type="checkbox"/></label><div class="dialog-actions"><button id="privacy-save" class="button">Save choices</button><button id="privacy-reject" class="button secondary">Reject optional</button><button id="privacy-accept" class="button secondary">Allow analytics</button></div><a href="/privacy/">How Floatlet handles data</a></form></dialog>
<script>import '../scripts/privacy'; import '../scripts/motion';</script></body></html>
