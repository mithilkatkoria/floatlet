---
import {product} from '../data/site';
import {release} from '../data/release';
import '../styles/global.css';
const {title=product.name,description=product.description}=Astro.props;
const canonical=product.origin?new URL(Astro.url.pathname,product.origin).href:null;
const indexable=product.mode==='production'&&!['/privacy/','/terms/','/404.html'].includes(Astro.url.pathname);
const structured={'@context':'https://schema.org','@graph':[
{'@type':'WebSite','@id':product.origin+'/#website',url:product.origin+'/',name:'Floatlet',description:product.description},
{'@type':'SoftwareApplication','@id':product.origin+'/#app',name:'Floatlet',url:product.origin+'/',description:product.description,applicationCategory:'UtilitiesApplication',operatingSystem:'Windows 11',softwareVersion:release?.version,downloadUrl:release?.url,license:product.repository+'/blob/main/LICENSE',isAccessibleForFree:true,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},author:{'@type':'Person',name:product.author,url:'https://github.com/mithilkatkoria'}}]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow':'noindex,follow'}/><title>{title}</title>{canonical&&<link rel="canonical" href={canonical}/>}
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical&&<meta property="og:url" content={canonical}/>}<meta name="twitter:card" content="summary"/><meta name="theme-color" content="#f7f6f2"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script is:inline type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} /></head>
<body><a class="skip" href="#main">Skip to content</a><header class="site-header wrap"><a class="wordmark" href="/" aria-label="Floatlet home"><span class="brand-pill" aria-hidden="true"></span>Floatlet<span class="beta">PREVIEW</span></a><nav aria-label="Main navigation"><a href="/#experience">Explore</a><a href="/docs/install/">Guide</a><a class="nav-download" href="/download/">Get Floatlet <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><slot/></main>
<footer class="wrap"><div class="footer-top"><a class="wordmark" href="/"><span class="brand-pill" aria-hidden="true"></span>Floatlet</a><p>A little more room for what matters.</p><a href={product.repository} data-event="github_click">Find us on GitHub ↗</a></div><div class="footer-links"><span>© {new Date().getFullYear()} {product.author}</span><a href="/dynamic-island-for-windows/">Windows guide</a><a href="/support/">Support</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/licenses/">Licenses</a><button class="text-button" id="privacy-open">Privacy settings</button></div><p class="fine">Independent software for Windows. Not affiliated with Apple or Microsoft.</p></footer>
<dialog id="privacy-dialog" aria-labelledby="privacy-title"><form method="dialog"><button class="dialog-close" aria-label="Close privacy settings">×</button><p class="eyebrow">YOUR CHOICE</p><h2 id="privacy-title">A little privacy, too.</h2><p>Optional measurement is disabled in this preview. Your choice never affects downloads or the demo.</p><label class="choice"><span>Usage analytics<small>Understand which features visitors explore.</small></span><input id="analytics-choice" type="checkbox"/></label><label class="choice"><span>Session replay<small>Understand usability with masked sample content.</small></span><input id="replay-choice" type="checkbox"/></label><div class="dialog-actions"><button id="privacy-save" class="button">Save choices</button><button id="privacy-reject" class="button secondary">Reject optional</button><button id="privacy-accept" class="button secondary">Accept optional</button></div><a href="/privacy/">How this preview handles data</a></form></dialog>
<script>import '../scripts/privacy'; import '../scripts/motion';</script></body></html>
